{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "server/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.ts",
    ".dependency-cruiser.ts"
  ]
}
