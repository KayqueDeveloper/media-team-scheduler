{
  "name": "escala-transmissao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/contracts/tsconfig.build.json packages/scheduling-domain/tsconfig.build.json",
    "build:api": "tsc -b apps/api/tsconfig.build.json",
    "build:typescript": "tsc -b",
    "pretest": "npm run build:typescript",
    "preserver": "npm run build:typescript",
    "prestart": "npm run build:typescript",
    "dev": "vite",
    "server": "node --import tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "seed": "node --import tsx server/db/seed.ts",
    "import:volunteers": "node --import tsx server/db/importVolunteers.ts",
    "test": "npm run test:typed && npm run test:api && npm run test:unit",
    "test:unit": "node --import tsx --test --test-reporter=spec server/solver/scheduler.test.ts server/email.test.ts src/api/client.test.ts",
    "test:solver": "node --import tsx --test server/solver/scheduler.test.ts",
    "test:api": "node --import tsx --test --test-reporter=spec --test-concurrency=1 server/api.test.ts",
    "test:db": "node --import tsx server/db/test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json && tsc -p tsconfig.legacy.json",
    "lint": "node --experimental-strip-types ./node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config apps packages vitest.config.ts --max-warnings=0",
    "architecture:check": "depcruise apps packages server src e2e --config .dependency-cruiser.ts",
    "format:check": "prettier --check apps packages *.json *.ts .dependency-cruiser.ts",
    "test:typed": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node --import tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "migrate:postgres": "node --import tsx server/db/migrateSqliteToPostgres.ts",
    "reminders:send": "node --import tsx --env-file-if-exists=.env server/jobs/sendServiceConfirmationReminders.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-query": "5.101.4",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.28.0",
    "nodemailer": "9.0.5",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
