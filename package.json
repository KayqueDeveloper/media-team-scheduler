{
  "name": "escala-transmissao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "seed": "node server/db/seed.js",
    "import:volunteers": "node server/db/importVolunteers.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 server/solver/scheduler.test.js server/api.test.js src/api/client.test.js",
    "test:solver": "node --test server/solver/scheduler.test.js",
    "test:api": "node --test --test-concurrency=1 server/api.test.js src/api/client.test.js",
    "test:db": "node server/db/test.js",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "migrate:postgres": "node server/db/migrateSqliteToPostgres.js",
    "reminders:send": "node --env-file-if-exists=.env server/jobs/sendServiceConfirmationReminders.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.28.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0"
  }
}
